{
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate.js": { "maxDuration": 30 },
    "api/source.js":   { "maxDuration": 30 },
    "api/xray.js":     { "maxDuration": 30 },
    "api/intake.js":   { "maxDuration": 30 },
    "api/enrich.js":   { "maxDuration": 30 },
    "api/clay.js":     { "maxDuration": 30 },
    "api/github.js":   { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/api/source",   "destination": "/api/source"   },
    { "source": "/api/xray",     "destination": "/api/xray"     },
    { "source": "/api/intake",   "destination": "/api/intake"   },
    { "source": "/api/enrich",   "destination": "/api/enrich"   },
    { "source": "/api/clay",     "destination": "/api/clay"     },
    { "source": "/api/github",   "destination": "/api/github"   },
    { "source": "/(.*)",         "destination": "/index.html"   }
  ]
}
